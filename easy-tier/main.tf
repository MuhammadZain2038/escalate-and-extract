terraform {
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

variable "ls_endpoint" {
  description = "LocalStack endpoint URL"
  type        = string
  default     = "http://localhost:4566"
}

variable "bucket_suffix" {
  description = "Random suffix for this session's bucket name"
  type        = string
}

variable "flag_value" {
  description = "This session's flag, generated by the backend"
  type        = string
}

provider "aws" {
  region                      = "us-east-1"
  access_key                  = "test"
  secret_key                  = "test"
  skip_credentials_validation = true
  skip_metadata_api_check     = true
  skip_requesting_account_id  = true
  s3_use_path_style           = true

  endpoints {
    s3  = var.ls_endpoint
    iam = var.ls_endpoint
    sts = var.ls_endpoint
  }
}

# 1. The bucket itself — just a storage container, nothing vulnerable yet
resource "aws_s3_bucket" "flag_bucket" {
  bucket = "corptech-dev-assets-${var.bucket_suffix}"
}

# 2. Disable AWS's built-in public-access safety net.
#    This is the step that turns "possible to misconfigure" into "actually misconfigured" —
#    without this, step 3's public policy would be silently blocked by AWS itself.
resource "aws_s3_bucket_public_access_block" "flag_bucket" {
  bucket = aws_s3_bucket.flag_bucket.id

  block_public_acls       = false
  block_public_policy     = false
  ignore_public_acls      = false
  restrict_public_buckets = false
}

# 3. The actual vulnerability: a bucket policy granting read access to literally anyone.
#    Principal = "*" means "no authentication required."
resource "aws_s3_bucket_policy" "public_read" {
  bucket = aws_s3_bucket.flag_bucket.id
  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Sid       = "PublicReadGetObject"
        Effect    = "Allow"
        Principal = "*"
        Action    = "s3:GetObject"
        Resource  = "${aws_s3_bucket.flag_bucket.arn}/*"
      }
    ]
  })

  depends_on = [aws_s3_bucket_public_access_block.flag_bucket]
}

# 4. The flag, sitting inside, waiting to be read by anyone who finds the bucket.
resource "aws_s3_object" "flag" {
  bucket       = aws_s3_bucket.flag_bucket.id
  key          = "flag.txt"
  content      = var.flag_value
  content_type = "text/plain"
}

output "bucket_name" {
  value = aws_s3_bucket.flag_bucket.id
}